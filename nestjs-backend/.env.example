# Database Configuration
# For MySQL (PlanetScale, AWS RDS, etc.)
DATABASE_URL="mysql://username:password@host:3306/database_name?sslaccept=strict"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here"
TOKEN_SECRET="your-super-secret-token-key-here"

# Frontend URL (for CORS and email links)
FRONTEND_URL="http://localhost:3000"

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Common SMTP Providers:
# Gmail: smtp.gmail.com:587 (secure=false) or smtp.gmail.com:465 (secure=true)
# Outlook: smtp-mail.outlook.com:587 (secure=false)
# Yahoo: smtp.mail.yahoo.com:587 (secure=false)
# SendGrid: smtp.sendgrid.net:587 (secure=false)
# Mailgun: smtp.mailgun.org:587 (secure=false)

# Note: For Gmail, you need to use an "App Password" instead of your regular password
# Enable 2FA and generate an App Password at: https://myaccount.google.com/apppasswords

# ===========================================
# VERCEL DEPLOYMENT NOTES
# ===========================================
#
# 1. Add these environment variables in Vercel Dashboard:
#    - Go to your project > Settings > Environment Variables
#    - Add each variable listed above
#
# 2. For DATABASE_URL with PlanetScale:
#    DATABASE_URL="mysql://username:password@aws.connect.psdb.cloud/dbname?sslaccept=strict"
#
# 3. For production CORS_ORIGINS:
#    CORS_ORIGINS="https://your-frontend.vercel.app,https://your-custom-domain.com"
#
# 4. For production FRONTEND_URL:
#    FRONTEND_URL="https://your-frontend.vercel.app"
